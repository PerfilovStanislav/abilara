{
    "name": "perfilov/abilara",
    "description": "Laravel authorization package with RBAC + ABAC support, nested groups, hierarchical roles, recursive permission inheritance, abilities, and unified access control management.",
    "keywords": [
        "laravel",
        "authorization",
        "rbac",
        "abac",
        "acl",
        "permissions",
        "roles",
        "nested-roles",
        "nested-groups",
        "access-control",
        "security",
        "policy"
    ],
    "license": "MIT",
    "type": "library",
    "time": "2026-05-28",
    "default-branch": true,
    "authors": [
        {
            "name": "Perfilov Stanislav",
            "email": "stanislav.perfilov@gmail.com",
            "homepage": "https://beacons.ai/stanislavperfilov",
            "role": "developer"
        }
    ],
    "homepage": "https://beacons.ai/stanislavperfilov",
    "require": {
        "php": ">=8.1",
        "illuminate/support": ">=8.0",
        "illuminate/console": ">=8.0",
        "illuminate/database": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "Abilara\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Abilara\\AbilaraServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
